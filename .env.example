# 后端端口
PORT=3001
# JWT 密钥（请改成随机长字符串）
JWT_SECRET=change-me-to-a-random-secret
# 前端地址（邮件里的链接会指向这里）
APP_URL=http://localhost:5173

# SMTP 发件邮箱配置（以 QQ 邮箱为例，需在邮箱设置中开启 SMTP 并获取授权码）
# 不配置时进入开发模式：邮件内容打印到服务端控制台，注册接口会直接返回验证链接
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=