# 复制本文件为 .env 后填写真实值（.env 不会被打包进镜像）
PORT=3001

# JWT 密钥：用命令生成一个随机串填入
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=在此填入随机长字符串

# 公开访问地址：邮件里的验证/通知链接会指向这里
# 用 IP+端口时填 http://你的服务器公网IP:3001
APP_URL=http://你的服务器公网IP:3001

# SMTP 发件邮箱（以 QQ 邮箱为例，需开启 SMTP 并获取授权码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的邮箱@qq.com
SMTP_PASS=你的SMTP授权码
SMTP_FROM=你的邮箱@qq.com